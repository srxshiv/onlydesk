    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@onlydesk/shared-types": "workspace:*",
    "@onlydesk/tool-ui-kit": "workspace:*",
    "@onlydesk/tools-sdk": "workspace:*"
  },
  "devDependencies": {
    "@onlydesk/config": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "@types/react": "^19.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.62.7",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0"
  }
