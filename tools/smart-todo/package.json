{
  "name": "@onlydesk/tool-smart-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui": "./src/ui/index.tsx"
  },
  "files": [
    "dist",
    "src/ui"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
