{
  "name": "onlydesk",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@onlydesk/api",
    "dev:web": "turbo run dev --filter=@onlydesk/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "pnpm --filter @onlydesk/api migration:run",
    "db:migrate:gen": "pnpm --filter @onlydesk/api migration:generate",
    "db:seed": "pnpm --filter @onlydesk/api seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@onlydesk/config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
