NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://onlydesk:onlydesk@localhost:5432/onlydesk

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-in-prod-please-min-32-chars
JWT_REFRESH_SECRET=also-change-me-in-prod-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# At-rest encryption for per-tool secrets (installed_tools.config).
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=ZGV2LW9ubHktY2hhbmdlLW1lLTMyLWJ5dGVzLWtleSE=

# Async tool-action queue (BullMQ) tuning
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=2000
JOB_TIMEOUT_MS=120000
JOB_CONCURRENCY=5

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Google ADK / Gemini
GOOGLE_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-pro
